# Copy values into SSM Parameter Store under /mini-jira/prod/<KEY>
# Use: infrastructure/ssm/sync-parameters.sh (requires AWS CLI + IAM)

AWS_REGION=eu-north-1
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
DYNAMODB_FALLBACK_TO_MEMORY=false
CLOUDWATCH_METRICS_ENABLED=true

# Cognito
COGNITO_USER_POOL_ID=eu-north-1_7kSYxgEr6
COGNITO_CLIENT_ID=mu4hog4jim74lhah2s4svbv41
COGNITO_ISSUER=https://cognito-idp.eu-north-1.amazonaws.com/eu-north-1_7kSYxgEr6

# DynamoDB tables
DYNAMODB_USERS_TABLE=Mini-jira-Users
DYNAMODB_TEAMS_TABLE=Mini-jira-Teams
DYNAMODB_TASKS_TABLE=Mini-jira-Tasks
DYNAMODB_PROJECTS_TABLE=Mini-jira-Projects
DYNAMODB_AUDIT_LOG_TABLE=Mini-jira-AuditLog
DYNAMODB_COMMENTS_TABLE=Mini-jira-Comments
DYNAMODB_ACTIVITY_LOGS_TABLE=ActivityLogs

# S3 (update bucket names if yours differ)
S3_ORIGINAL_IMAGES_BUCKET=mini-jira-original-images-giu
S3_RESIZED_IMAGES_BUCKET=mini-jira-resized-images-giu

# CORS — CloudFront distribution hostname
FRONTEND_ORIGIN=https://d3sty91ryq307z.cloudfront.net

# Messaging (optional — used by Lambdas; document for EC2 if wired later)
SNS_TASK_ASSIGNMENT_TOPIC_ARN=arn:aws:sns:eu-north-1:507210367772:task-assignment-topic
SNS_DAILY_DIGEST_TOPIC_ARN=arn:aws:sns:eu-north-1:507210367772:daily-digest-topic
SQS_TASK_ASSIGNMENT_QUEUE_URL=https://sqs.eu-north-1.amazonaws.com/507210367772/task-assignment-queue
SQS_TASK_ASSIGNMENT_DLQ_URL=https://sqs.eu-north-1.amazonaws.com/507210367772/task-assignment-dlq
