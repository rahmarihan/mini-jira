# Copy to backend/.env and adjust for your environment
# cp .env.example .env

PORT=3001
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:3000

# AWS
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cognito (M1)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ISSUER=

# DynamoDB table names (M5 script + M1 env.validation)
DYNAMODB_USERS_TABLE=Mini-jira-Users
DYNAMODB_TEAMS_TABLE=Mini-jira-Teams
DYNAMODB_TASKS_TABLE=Mini-jira-Tasks
DYNAMODB_PROJECTS_TABLE=Mini-jira-Projects
DYNAMODB_AUDIT_LOG_TABLE=Mini-jira-AuditLog
DYNAMODB_COMMENTS_TABLE=Mini-jira-Comments
DYNAMODB_NOTIFICATIONS_TABLE=Mini-jira-Notifications

# Use in-memory store when AWS tables are unavailable (set false in production)
DYNAMODB_FALLBACK_TO_MEMORY=true
