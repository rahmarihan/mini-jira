# =============================================================================
# Mini-Jira — copy to .env and fill secrets locally (never commit .env)
# =============================================================================
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
AWS_REGION=eu-north-1
AWS_ACCOUNT_ID=507210367772

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

FRONTEND_ORIGIN=http://localhost:3000
DYNAMODB_FALLBACK_TO_MEMORY=false
CLOUDWATCH_METRICS_ENABLED=true

# =============================================================================
# AWS Services Owned (eu-north-1)
# EC2+ASG | ALB | CloudFront | CloudWatch dashboard+alarm | Cognito | DynamoDB
# | Lambda | SNS | SQS
# =============================================================================

ASG_NAME=mini-jira-asg
EC2_INSTANCE_ID_A=i-0cabde365d7a06081
EC2_INSTANCE_ID_B=i-0dbb8744f4376b3cb
IAM_EC2_ROLE_ARN=arn:aws:iam::507210367772:role/MiniJira-EC2-Role

ALB_DNS=mini-jira-alb-74822711.eu-north-1.elb.amazonaws.com
CLOUDFRONT_DOMAIN=d3sty91ryq307z.cloudfront.net
CLOUDFRONT_URL=https://d3sty91ryq307z.cloudfront.net

CLOUDWATCH_DASHBOARD_NAME=mini-jira-notifications-dashboard
CLOUDWATCH_DASHBOARD_URL=https://eu-north-1.console.aws.amazon.com/cloudwatch/home?region=eu-north-1#dashboards/dashboard/mini-jira-notifications-dashboard
CLOUDWATCH_METRICS_NAMESPACE=MiniJira/Tasks
CLOUDWATCH_ALARM_OVERDUE_TASKS=mini-jira-overdue-tasks-high
CLOUDWATCH_ALARM_OVERDUE_THRESHOLD=10
SNS_ALARM_TOPIC_ARN=arn:aws:sns:eu-north-1:507210367772:daily-digest-topic

COGNITO_USER_POOL_ID=eu-north-1_7kSYxgEr6
COGNITO_CLIENT_ID=mu4hog4jim74lhah2s4svbv41
COGNITO_ISSUER=https://cognito-idp.eu-north-1.amazonaws.com/eu-north-1_7kSYxgEr6

DYNAMODB_USERS_TABLE=Mini-jira-Users
DYNAMODB_TEAMS_TABLE=Mini-jira-Teams
DYNAMODB_TASKS_TABLE=Mini-jira-Tasks
DYNAMODB_PROJECTS_TABLE=Mini-jira-Projects
DYNAMODB_AUDIT_LOG_TABLE=Mini-jira-AuditLog
DYNAMODB_COMMENTS_TABLE=Mini-jira-Comments
DYNAMODB_ACTIVITY_LOGS_TABLE=ActivityLogs

SNS_TASK_ASSIGNMENT_TOPIC_ARN=arn:aws:sns:eu-north-1:507210367772:task-assignment-topic
SNS_DAILY_DIGEST_TOPIC_ARN=arn:aws:sns:eu-north-1:507210367772:daily-digest-topic
SQS_TASK_ASSIGNMENT_QUEUE_URL=https://sqs.eu-north-1.amazonaws.com/507210367772/task-assignment-queue
SQS_TASK_ASSIGNMENT_DLQ_URL=https://sqs.eu-north-1.amazonaws.com/507210367772/task-assignment-dlq
